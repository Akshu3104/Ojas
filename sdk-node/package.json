{
  "name": "@devpulse/sdk",
  "version": "0.1.0",
  "description": "Node SDK for routing OpenAI / Anthropic traffic through the DevPulse gateway.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "openai": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "openai": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
