{
  "name": "@devpulse/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Inline LLM gateway for DevPulse — proxies OpenAI/Anthropic/Bedrock with kill-switch, PII redaction, prompt-injection blocking and token metering.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
